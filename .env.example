# ---------- پایگاه داده ----------
# PostgreSQL (لوکال یا Neon). برای Neon از رشته اتصال pooled با ?sslmode=require استفاده کنید.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- برنامه ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- اختیاری: ورود با گوگل (در صورت افزودن NextAuth) ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=

# ---------- اختیاری: ارسال ایمیل بازیابی رمز (مثلاً Resend) ----------
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@example.com

# ---------- اختیاری: آپلود تصویر سؤالات (Uploadthing) ----------
# UPLOADTHING_TOKEN=
